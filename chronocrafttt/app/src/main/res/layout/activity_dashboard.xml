
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/Tabtaskbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#9A7BBE"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:paddingBottom="20dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/ic_launcher" />
        <!-- App name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="8dp"
            android:layout_toRightOf="@id/imgLogo"/>
        <ImageView
            android:id="@+id/optionsMenu"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/menu_icon"
            android:contentDescription="Options menu"
            android:paddingTop="10dp"
            android:layout_gravity="end"
            app:tint="@color/white"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>


    <!-- Tabs for My Todo List and My Notes -->
    <LinearLayout
        android:id="@+id/topTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/Tabtaskbar"
        android:paddingTop="8dp">

        <!-- My Todo List Tab -->
        <TextView
            android:id="@+id/tabMyTodoList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/todo"
            android:gravity="center"
            android:padding="12dp"
            android:background="#EEEEEE"
            android:textColor="#6200EE"
            android:textStyle="bold" />

        <!-- My Notes Tab -->
        <TextView
            android:id="@+id/tabMyNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/note"
            android:gravity="center"
            android:padding="12dp"
            android:background="#EEEEEE"
            android:textColor="#6200EE"
            android:textStyle="bold" />


    </LinearLayout>

    <!-- Content Display -->
    <TextView
        android:id="@+id/tvNoTasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notask"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:visibility="gone" />

    <ExpandableListView
        android:id="@+id/lvItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/topTabs"
        android:layout_above="@id/bottomButtons"
        android:divider="@android:color/black"
        android:dividerHeight="1dp"
        />

    <!-- Bottom Buttons -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAddTodoList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/addtodo"
            android:layout_margin="15dp"
            android:background="#67468d"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnAddNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="15dp"
            android:text="@string/addnote"
            android:background="#67468d"
            android:textColor="@color/white" />
    </LinearLayout>

</RelativeLayout>